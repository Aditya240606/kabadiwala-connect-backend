# ==============================================================================
# Kabadiwala Connect Backend Environment Configuration Template
# Copy this file to .env or export these variables in your environment.
# ==============================================================================

# Database Configuration (Supabase PostgreSQL or Local PostgreSQL)
# For Supabase, use your project database connection string (Session Pooler or Direct):
# jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://localhost:5432/postgres
SUPABASE_DB_USERNAME=postgres
SUPABASE_DB_PASSWORD=your_database_password_here

# Supabase Project & Auth Configuration
# Project Settings -> API in Supabase Dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional explicit JWT JWKS URI (defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
SUPABASE_AUTH_ISSUER=
SUPABASE_AUTH_JWK_SET_URI=

# Storage Configuration
SUPABASE_STORAGE_BUCKET=ewaste-images
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=./storage/uploads

# FastAPI ML Inference Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_ENABLED=true
